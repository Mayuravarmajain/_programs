def is_prime(n):
    """Check if a number is prime."""
    if n < 2:
        return False
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False
    return True

def count_brave_soldiers(n):
    """Count the number of prime numbers up to N."""
    count = 0
    for num in range(1, n + 1):  # Check each number
        if is_prime(num):  # If prime, count it
            count += 1
    return count

def main():
    import sys
    input = sys.stdin.read
    n = int(input().strip())  # Read input
    
    result = count_brave_soldiers(n)
    print(result)

if __name__ == "__main__":
    main()
