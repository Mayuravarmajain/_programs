        {
            cout<< "invalid pos entered!"<<endl;
            
        }
        else if(pos==0)
        {
           // insertAtHead(val);
           n->Next=Head;
           Head=n;
        }
        else
        {
            Node * temp=Head;
        
        
           // while(pos!=i)
           while(--pos)
            {
               // i++;
                temp=temp->Next;
            
            }
             n->Next=temp->Next;
            temp->Next=n;
           
            
        }
    }
    
    
    void deleteAtHead(){
        if (Head==NULL)
        {
            cout<<"linked list empty"<<endl;
            return;
        }
        else
        {
              Node *temp=Head;
              Head=Head->Next;
              cout<<"deleted element  "<<temp->data<<endl;
              delete temp;
        }
      }
      
      void deleteAtValue(int val)
      {
         if(Head==NULL)
         {
             cout<<"Linked list empty"<<endl;
             return;
        }
        else if(Head->Next==NULL)
