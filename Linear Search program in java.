class searching
{
    public int linear_search(int arr[],int target)
    {
        
        for(int i=0;i<arr.length;i++)
        {
            if(arr[i]==target)
            {
                return i;
            }
        }
        return -1;
    }
}
class Main {
    public static void main(String[] args) {
        int[] arr={23,55,7,887,9};
        int t=9;
        searching s=new searching();
         int result=s.linear_search(arr,t);
         
         if(result!=-1)
         {
             System.out.println("Element is get successfully at position\t::"+result);
         }
         else
         {
             System.out.println("Element is not found");
         }
         }
   
    }
