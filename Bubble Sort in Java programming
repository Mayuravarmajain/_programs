class Main {
    
    public static void Bubble_sort(int[] arr)
    {
        int n= arr.length;
        
        for(int i=0;i<n-1;i++)
        {
            for(int j=0;j<n-i-1;j++)
            {
                if(arr[j]>arr[j+1])
                {
                    int temp = arr[j+1];
                    arr[j+1]=arr[j];
                    arr[j]=temp;
                }
            }
        }
    }
    
    public static void main(String[] args) {
       int[] arr={100,3,2,9,44,5,99};
      Bubble_sort(arr);
      System.out.println("sorted array");
      for(int res:arr)
      {
          System.out.print(res+" ");
      }
      
    }
}
